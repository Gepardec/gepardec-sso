{
    "name": "gepardec-sso-theme",
    "version": "0.0.0",
    "description": "All theme customisations for Gepardec SSO",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme": "npm run build && keycloakify build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "storybook": "storybook dev -p 6006",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "license": "UNLICENSED",
    "keywords": [],
    "dependencies": {
        "@fontsource/barlow-semi-condensed": "^5.3.0",
        "keycloakify": "^11.16.0",
        "react": "^18.2.0",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@storybook/react-vite": "^10.6.9",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.74.0",
        "@typescript-eslint/parser": "^8.74.0",
        "@vitejs/plugin-react": "^6.0.0",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^10.1.9",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "eslint-plugin-storybook": "^10.6.8",
        "globals": "^15.12.0",
        "prettier": "3.10.1",
        "storybook": "^10.6.9",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.0.0"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
